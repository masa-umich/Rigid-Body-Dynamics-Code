function [updatedState] = RK4Solver(state, dt, percentage, mass, Iyy, t)
% RK4 numerical integration

    f0 = getNewStateDerivs(state, percentage, mass, Iyy, t);
    %disp(f0);
    f1 = getNewStateDerivs(state + 0.5*dt*f0, percentage, mass, Iyy, t);
    %disp(f1);
    f2 = getNewStateDerivs(state + 0.5*dt*f1, percentage, mass, Iyy, t);
    %disp(f2);
    f3 = getNewStateDerivs(state + dt*f2, percentage, mass, Iyy, t);
    %disp(f3);
    
    updatedState = state + (dt/6)*(f0 + 2*f1 + 2*f2 + f3);
    %updatedState(6) = mod(updatedState(6), 2*pi);
    disp("state: " + updatedState);
end



