%% state vector form: [xp,zp,u,w,q,theta]

close all; clear; clc;
format long g;
% FAR Launch Site Altutude
farAlt = 609.6; %(m)

% Apogee Input
apogee = 10668; %(m)

% Inputs
u = 50; % x component of COM velo. body (change to fixed) coordinate system (m/s)
w = 0; % z component of COM velo. body (change to fixed) coordinate system (m/s)
q = 0; % y component of rotation rate body coordinate syatem (rad/s)
theta = 0; % pitch (rad)
xp = 0; % x position in global coordinate system (m)
zp = apogee; % z position in global coordinate system (m)
t = 0 ;
x_rel = 0; 
v_rel = 0;
[~, ~, rho, ~] = atmosphere(zp);

% Wind for getVw
percentage = '0';

% Limelight Parameters
mass = 231; % vehicle dry mass (kg)
Iyy = 1750; % vehicle moment of inertia about the y-axis (kg*m^2) NOT REAL
rArea = 2.368; % (m^2)
D = 7.4; % (m)

% Inital state vector
state0 = [xp, zp, u, w, q, theta, x_rel, v_rel];
state = state0;

%Time after appogee recovery bay is deployed
timeAfterAppogee = 2; %(s)

%Integrating for freefall

i = 1;
time(i,1) = t;
t_elapsed = 0;

f_ch = [];   % parachute load history [N]
fP_dir = [];   % parachute load history [N]
para_t = 0;
%freefall
while state(end,2) > farAlt
% while time(i) < 100
    dt = 0.1;
    if(state(end, 2) < 609.6 +305) 
        dt = 0.001;
    end
    if(t_elapsed > 2) 
        dt = 0.001; 
    end
    if(t_elapsed > 4)
        dt = 0.1;
    end
    [state(i+1,:),fP, t_elapsed] = RK4Solver(state(i,:),dt,percentage,mass,Iyy,t, t_elapsed);
    f_ch(i+1) = norm(fP);
    fP_dir = [fP_dir, (fP ./ norm(fP)];
    t = t+dt;
    i = i+1;
    time(i,1) = t;
    
end

figure(1)
subplot(1,2,1)
plot(time,rad2deg(state(:,6)));
ylabel('Theta [deg]')
xlabel('Time (s)')
title('Theta [deg] i.r.t. horiz vs Time')

subplot(1,2,2)
plot(time,state(:,2));
ylabel('Altitude [m]')
xlabel('Time (s)')
title('Altitude vs Time')

figure(2)
plot(state(:,1), state(:,2))
ylabel('y pos [m]')
xlabel('x pos [m]')
title('Absolute position')

figure(3)
plot(time, f_ch)
ylabel('Force [N]')
xlabel('x pos [m]')
title('Force Graph')

%disp(['Terminal velocity in pilot chute phase is: ',num2str(min(state(:,4))) , ' m/s'])
disp(['Limelight descended ',num2str(1*(-state(end,2)+state(1,2))), ' m under pilot chute flight phase'])


[maxLoad, idx] = max(f_ch);

disp(['MAX parachute load = ', num2str(maxLoad), ' N'])
disp(['Occurs at t = ', num2str(time(idx)), ' s'])
disp(['Occurs at t = ', num2str(time(idx) - (t - t_elapsed)), ' s after reaching main height'])
disp(['Altitude at max load = ', num2str(state(idx,2)), ' m'])

%% --- Accelerated Rocket Swing Animation (Full Final Version) ---
disp('Playing and recording animation at accelerated speed...');

% 1. Speed Control Settings
fps = 30;                 % Standard smooth video framerate
speedMultiplier = 5;      % 5x speed (Change to 2, 10, etc. as needed)
dt_anim = speedMultiplier / fps; % Simulation time advanced per frame

t_anim = time(1):dt_anim:time(end); 

xp_anim = interp1(time, state(:,1), t_anim);
zp_anim = interp1(time, state(:,2), t_anim);
theta_anim = interp1(time, state(:,6), t_anim);
x_rel_anim = interp1(time, state(:,7), t_anim); 

% 2. Setup VISIBLE Figure (Do not resize window while running!)
figAnim = figure('Name', 'Rocket Descent & Pitch Animation', 'Color', 'w', ...
                 'Position', [100, 100, 800, 600]);
ax = axes('Parent', figAnim);
hold(ax, 'on'); grid(ax, 'on');
xlabel(ax, 'X Position [m]');
ylabel(ax, 'Altitude (Z) [m]');

% Deployment Altitudes & Sizes
drogueAlt = 609.6 + 1524;
mainAlt = 609.6 + 305;
bagLength = 15; 
rocketLength = 10; 
viewWindow = 100; 

% Draw fixed horizontal lines
yline(ax, drogueAlt, 'b--', 'Drogue Deploy Alt', 'LabelHorizontalAlignment', 'left', 'LineWidth', 1.5);
yline(ax, mainAlt, 'r--', 'Main Deploy Alt', 'LabelHorizontalAlignment', 'left', 'LineWidth', 1.5);

% Initialize graphics objects
trajectoryLine = plot(ax, NaN, NaN, 'k--', 'LineWidth', 1); 
rocketBody = plot(ax, NaN, NaN, 'k-', 'LineWidth', 4);      
% --- NEW: Use a filled polygon for the nose cone instead of a static marker ---
noseCone = fill(ax, NaN, NaN, 'r', 'EdgeColor', 'r');
tetherLine = plot(ax, NaN, NaN, 'k-', 'LineWidth', 1);
canopyPlot = plot(ax, NaN, NaN, 'b-', 'LineWidth', 4); 

% 3. Video Setup
videoFilename = 'Limelight_Descent_5x_35kAPOGEE.mp4';
v = VideoWriter(videoFilename, 'MPEG-4'); 
v.FrameRate = fps;                        
open(v);                                  

% 4. Animation Loop
for k = 1:length(t_anim)
    % Skip if you manually close the window
    if ~isgraphics(figAnim)
        break;
    end

    curr_x = xp_anim(k);
    curr_z = zp_anim(k);
    curr_theta = theta_anim(k);
    curr_x_rel = x_rel_anim(k);
    
    x_nose = curr_x + (rocketLength/2) * cos(curr_theta);
    z_nose = curr_z + (rocketLength/2) * sin(curr_theta);
    x_tail = curr_x - (rocketLength/2) * cos(curr_theta);
    z_tail = curr_z - (rocketLength/2) * sin(curr_theta);
    
    % --- Parachute Logic ---
    if t_anim(k) < 2
        % Phase 0: Freefall (First 2 seconds)
        phaseText = 'Freefall (No Chute)';
        canopyWidth = 0; tetherLength = 0; canopyColor = 'none';
        
    elseif curr_z > drogueAlt
        % Phase 1: Pilot Chute 
        phaseText = 'Pilot Chute';
        canopyWidth = 5; tetherLength = 15; canopyColor = '#555555'; % Grey
        
    elseif curr_z > mainAlt
        % Phase 2: Drogue Chute
        phaseText = 'Drogue Chute';
        canopyWidth = 10; tetherLength = 25; canopyColor = '#0072BD'; % Blue
        
    else
        % Phase 3 & 4: Main Extraction and Full Deployment
        if curr_x_rel < bagLength
            phaseText = sprintf('Main Extracting (Bag: %.1fm)', curr_x_rel);
            canopyWidth = 10; tetherLength = 25 + curr_x_rel; canopyColor = '#D95319'; % Orange
        else
            phaseText = 'Main Fully Deployed';
            canopyWidth = 35; tetherLength = 50; canopyColor = '#77AC30'; % Massive Green
        end
    end
    
    % --- Apply Coordinates ---
    
    % Calculate the new attachment point (Halfway between center and nose)
    attachOffset = rocketLength / 4; 
    x_attach = curr_x + attachOffset * cos(curr_theta);
    z_attach = curr_z + attachOffset * sin(curr_theta);

    if canopyWidth == 0
        tether_x = [NaN, NaN];
        tether_z = [NaN, NaN];
        canopy_x = [NaN, NaN];
        canopy_z = [NaN, NaN];
    else
        % Tether now connects to the new attachment point instead of x_tail/z_tail
        tether_x = [x_attach, x_attach];
        tether_z = [z_attach, z_attach + tetherLength];
        
        % Canopy is centered directly above the new attachment point
        canopy_x = [x_attach - canopyWidth/2, x_attach + canopyWidth/2];
        canopy_z = [z_attach + tetherLength, z_attach + tetherLength];
    end
    
    % Update plot data
    set(trajectoryLine, 'XData', xp_anim(1:k), 'YData', zp_anim(1:k));
    set(rocketBody, 'XData', [x_tail, x_nose], 'YData', [z_tail, z_nose]);
    % --- NEW: Calculate rotated nose cone vertices ---
    nc_L = 5;   % Length of the nose cone
    nc_W = 3; % Width of the nose cone base
    
    % Local unrotated coordinates [Tip, Bottom Corner, Top Corner]
    loc_x = [nc_L, 0, 0]; 
    loc_z = [0, -nc_W/2, nc_W/2];
    
    % Rotate by curr_theta and translate to the nose position
    nc_x = x_nose + (loc_x .* cos(curr_theta) - loc_z .* sin(curr_theta));
    nc_z = z_nose + (loc_x .* sin(curr_theta) + loc_z .* cos(curr_theta));
    
    set(noseCone, 'XData', nc_x, 'YData', nc_z);
    % -------------------------------------------------
    
    set(tetherLine, 'XData', tether_x, 'YData', tether_z);
    set(canopyPlot, 'XData', canopy_x, 'YData', canopy_z, 'Color', canopyColor);
    
    xlim(ax, [curr_x - viewWindow, curr_x + viewWindow]);
    ylim(ax, [curr_z - viewWindow, curr_z + viewWindow]);
    
    title(ax, sprintf('Time: %.1fs | Alt: %.0fm | Pitch: %.1f deg\nSpeed: %dx | Phase: %s', ...
        t_anim(k), curr_z, rad2deg(curr_theta), speedMultiplier, phaseText));
    
    % Update the screen visually 
    drawnow limitrate; 
    
    % --- Safe Video Capture ---
    frame = getframe(figAnim); 
    % Force dimensions to avoid H.264 padding errors (matches position 800x600)
    frame.cdata = imresize(frame.cdata, [600, 800]); 
    writeVideo(v, frame);      
end

close(v);
disp(['Video saved successfully to ', videoFilename]);